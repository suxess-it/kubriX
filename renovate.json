{
  "configMigration": true,
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "renovate-",
  "extends": [
    "config:recommended"
  ],
  "crossplane": {
    "managerFilePatterns": [
      "/.+provider\\.yaml$/",
      "/.+func\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^platform-apps/charts/backstage/[^/]+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/.*\\.(sh|ya?ml)$/"
      ],
      "matchStrings": [
        "helm plugin install https://github\\.com/(?<depName>nikhilsbhat/helm-images) --version (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/actions/install-kubrix-cli/action\\.yml$/"
      ],
      "matchStrings": [
        "CLI_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "suxess-it/kubrix-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform-apps/charts/openbao/[^/]+\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>quay\\.io/openbao/openbao):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform-apps\\/charts\\/testkube\\/templates\\/kind-(portal|delivery|security|observability)-test-playwright\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*mcr\\.microsoft\\.com/playwright:v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "@playwright/test",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "autoReplaceStringTemplate": "image: mcr.microsoft.com/playwright:v{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "rebaseWhen": "conflicted",
      "automerge": true,
      "addLabels": ["automerge","run-cluster-tests"]
    },
    {
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "major": {
        "semanticCommitType": "feat",
        "commitBody": "BREAKING CHANGE: Upgrade {{{depName}}} from {{{currentValue}}} to {{{newValue}}}."
      },
      "minor": {
        "semanticCommitType": "feat"
      },
      "patch": {
        "semanticCommitType": "fix"
      }
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/grafana-community/helm-charts/**"
      ],
      "sourceUrl": "https://github.com/grafana-community/helm-charts",
      "changelogUrl": "https://github.com/grafana-community/helm-charts/releases/tag/{{{replace '^.*/' '' depName}}}-{{newVersion}}"
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/prometheus-community/charts/prometheus-blackbox-exporter"
      ],
      "sourceUrl": "https://github.com/prometheus-community/helm-charts",
      "changelogUrl": "https://github.com/prometheus-community/helm-charts/releases/tag/{{depName}}-{{newVersion}}"
    },
    {
      "matchManagers": [
        "crossplane"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "xpkg.upbound.io/crossplane-contrib/provider-keycloak"
      ],
      "sourceUrl": "https://github.com/crossplane-contrib/provider-keycloak"
    },
    {
      "matchManagers": [
        "crossplane"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "xpkg.upbound.io/upbound/provider-vault"
      ],
      "sourceUrl": "https://github.com/upbound/provider-vault"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "testkube"
      ],
      "sourceUrl": "https://github.com/kubeshop/testkube",
      "changelogUrl": "https://github.com/kubeshop/testkube/releases/tag/{{newVersion}}"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "k8s-monitoring"
      ],
      "sourceUrl": "https://github.com/grafana/k8s-monitoring-helm",
      "sourceDirectory": "charts/k8s-monitoring"
    },
    {
      "matchPackageNames": [
        "suxess-it/kubrix-cli"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "@playwright/test"
      ],
      "groupName": "Playwright",
      "groupSlug": "playwright"
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchPackageNames": [
        "cluster"
      ],
      "matchFileNames": [
        "platform-apps/charts/**/Chart.yaml"
      ],
      "additionalBranchPrefix": "{{parentDir}}-"
    }
  ]
}
