default:
  valueFiles:
  - values-kubrix-default.yaml
  - values-cluster-{{ .kubriX.clusterType }}.yaml
  - values-provider-{{ .kubriX.cloudProvider }}.yaml
  {{ if .kubriX.haEnabled }}
  - values-ha-enabled.yaml
  {{ end -}}
  - values-size-{{ .kubriX.tShirtSize }}.yaml
  {{ if .kubriX.securityStrict }}
  - values-security-strict.yaml
  {{ end -}}
  - values-customer-generated.yaml
  - values-customer.yaml

applications:

  - name: prometheus-operator-crds
    annotations:
      argocd.argoproj.io/sync-wave: "-10"
    syncOptions:
      - ServerSideApply=true

  - name: traefik
    annotations:
      argocd.argoproj.io/sync-wave: "-10"

  - name: external-secrets
    annotations:
      argocd.argoproj.io/sync-wave: "-10"
    syncOptions:
      - ServerSideApply=true

  - name: cert-manager
    annotations:
      argocd.argoproj.io/sync-wave: "-10"

  - name: crossplane
    annotations:
      argocd.argoproj.io/sync-wave: "-10"

  - name: cnpg
    annotations:
      argocd.argoproj.io/compare-options: ServerSideDiff=true
      argocd.argoproj.io/sync-wave: "-10"
    syncOptions:
      - ServerSideApply=true

  {{ if ne .kubriX.clusterType "kind" -}}
  - name: external-dns
    annotations:
      argocd.argoproj.io/sync-wave: "-9"
    valueFiles:
      - values-dns-{{ .kubriX.dnsProvider }}.yaml
  {{ end -}}


  - name: argocd
    annotations:
      argocd.argoproj.io/sync-wave: "-9"
    syncOptions:
      - ServerSideApply=true

  - name: k8s-monitoring
    annotations:
      argocd.argoproj.io/compare-options: ServerSideDiff=true
      argocd.argoproj.io/sync-wave: "-8"
    syncOptions:
      - ServerSideApply=true

  - name: openbao
    annotations:
      argocd.argoproj.io/sync-wave: "-8"
      
  - name: keycloak
    annotations:
      argocd.argoproj.io/sync-wave: "-5"
    ignoreDifferences:
      - group: rbac.authorization.k8s.io
        kind: RoleBinding
        jqPathExpressions:
        - '.metadata.labels["app.kubernetes.io/version"]'

  - name: loki
    annotations:
      argocd.argoproj.io/compare-options: ServerSideDiff=true
      argocd.argoproj.io/sync-wave: "-1"
    helmOptions:
      skipCrds: true
    syncOptions:
      - ServerSideApply=true

  - name: kargo

  - name: argo-rollouts
      
  - name: grafana
    annotations:
      argocd.argoproj.io/compare-options: ServerSideDiff=true
    syncOptions:
      - ServerSideApply=true

  - name: mimir

  {{ if ne .kubriX.clusterType "kind" -}}

  - name: falco
    annotations:
      argocd.argoproj.io/compare-options: ServerSideDiff=true
    helmOptions:
      skipCrds: true
    syncOptions:
      - ServerSideApply=true

  - name: kyverno
    syncOptions:
      - ServerSideApply=true

  - name: velero

 #- name: velero-ui

  - name: minio

  {{ end -}}

  - name: backstage
    annotations:
      argocd.argoproj.io/sync-wave: "10"

  - name: team-onboarding
    destinationNamespaceOverwrite: argocd
    namespaceResourceTracking: false
    annotations:
      argocd.argoproj.io/sync-wave: "15"
