{
  "name": "kubrix-ci",
  "url": "https://github.com/suxess-it/kubriX",
  "description": "GitHub App for kubriX CI repository lifecycle, Backstage and delivery automation in kubriX-demo.",
  "public": false,
  "hook_attributes": {
    "url": "https://github.com/suxess-it/kubriX",
    "active": false
  },
  "default_permissions": {
    "administration": "write",
    "contents": "write",
    "metadata": "read",
    "pull_requests": "write",
    "statuses": "read",
    "workflows": "write"
  },
  "default_events": [],
  "request_oauth_on_install": false,
  "setup_on_update": false
}
